# Copy to .env and fill in. NEVER commit .env

# 1 = show OTP on screen (demo). 0 = send real email via SMTP
DEV_MODE=1

# This email becomes admin when it signs up
ADMIN_EMAIL=you@example.com

# Free key from https://aistudio.google.com
GEMINI_API_KEY=
# Lite models answer in ~5-10 s; full "thinking" models can take ~50 s
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order if the main model is busy
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash

# Voice input (Whisper). openai = OpenAI API (needs a key); local = faster-whisper on this machine, nothing leaves it
WHISPER_BACKEND=openai
OPENAI_API_KEY=
# WHISPER_LOCAL_SIZE=small

# Google Calendar sync (Pro plan and up). Create a "Web application" OAuth client, enable the Google Calendar API,
# and add GOOGLE_REDIRECT_URI as an authorised redirect URI. Apple Calendar needs no setup here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8502/calendar

# Optional; auto-generated into data/app.key if blank
APP_ENCRYPTION_KEY=

# Real email OTP (Gmail needs an "app password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
